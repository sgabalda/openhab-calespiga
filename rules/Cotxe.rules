rule "Activar o desactivar carregador Cotxe per MQTT" //THIS ONE IS TO KEEP until the RPI is replaced by an arduino for reading the sensor
when
    Item CotxeEncesa_Control_MQTTProxy changed
then
    val newState = CotxeEncesa_Control_MQTTProxy.state
    logInfo("Cotxe.rules", "The cotxe is going to be set to "+ CotxeEncesa_Control_MQTTProxy.state +" received from MQTT, as the SHS is enabled")
    if (newState == "on") {
        logInfo("Cotxe.rules", "The cotxe charger changed to ON as it has been turned on")
        CotxeEncesa_Control.sendCommand(ON)  //turn it on or off
    }else{
        logInfo("Cotxe.rules", "The cotxe charger changed to OFF as it has been turned off")
        CotxeEncesa_Control.sendCommand(OFF) 
    }
end
