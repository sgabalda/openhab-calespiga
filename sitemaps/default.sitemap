sitemap default label="Ca l'espiga" {

    Text item=PotenciaTitle label="Potencia" icon="solar_panel"
    {
        Frame label="Fotovoltaica" {
            Text item=PotenciaDisponibleSHS icon="energy" label="Potència disponible: [%.0f W]"
            Text item=PotenciaGeneradaSHS icon="light" label="Potència generada: [%.0f W]"
            Text item=PotenciaRebutjadaSHS icon="smoke" label="Potència rebutjada: [%.0f W]"
            Text item=PotenciaDinamicaFVSHS icon="power" label="Potència dinàmica FV: [%.0f W]"    
            Text item=PotenciaEstatLecturesSHS icon="receiver" label="Estat lectures FV: [%s]"  
        }
        Frame label="Consum" {
            Text item=PotenciaConsumCasaSHS icon="power" label="Consum casa: [%.0f W]"
            Text item=PotenciaConsumCasaEnergiaAvuiSHS icon="energy" label="Energia consumida casa avui: [%.3f kWh]"
            Text item=PotenciaXarxaSHS icon="electric_tower" label="Xarxa (+ consumida / - injectada): [%.0f W]"
            Text item=PotenciaDinamicaFVSHS icon="power" label="Potència dinàmica FV: [%.0f W]"
        }
        Frame label="Prioritat P. dinàmica" {
            Setpoint item=CalentadorPrioritatConsumSHS icon="heater_display" label="Prioritat calentador [%d]" minValue=1 maxValue=3 step=1
            Setpoint item=EstufaInfrarrojosPrioritatConsumSHS icon="radiator" label="Prioritat estufa infrarrojos [%d]" minValue=1 maxValue=3 step=1
            Setpoint item=CarChargerPrioritatConsumSHS icon="electric_car" label="Prioritat carregador VE [%d]" minValue=1 maxValue=3 step=1
        }
        
        Frame{
            Webview height=14 url="http://calespiga.ddns.net:3000/d/PUsS3Cmgz/fotovoltaica?orgId=1"
        }
    }

    Text item=CalentadorStatusSHS label="Calentador" icon="heater_display"
    {
        Frame label="Calentador" {
            
            Selection item=CalentadorSetSHS icon="thermostat_heater" mappings=["off"="Off", "500"="500W", "1000"="1000W", "2000"="2000W", "automatic"="Automàtic"]
            Text item=CalentadorStatusSHS icon="water_heater" label="Estat Pot.: [%d W]" 
            Text item=CalentadorTemperaturaSHS icon="temperature" label="Temperatura: [%.1f °C]"
            Setpoint item=CalentadorTemperaturaObjectiuSHS icon="temperature" label="Temperatura objectiu [%.1f °C]" minValue=0 maxValue=75 step=1


            Text item=CalentadorCalentSHS icon="calentador_termostat" label="Estat termostat: [%s]" 
            Text item=CalentadorUltimaVegadaCalentSHS icon="time" label="Ultim cop calent: [%s]" 
            
            Text item=CalentadorEnergiaAvuiSHS icon="energy" label="Energia avui: [%,d Wh]" 

            Text item=CalentadorSincronitzacioSHS icon="time" label="Sincronitzacio [%s]"
            Text item=CalentadorMicroControladorEstatSHS icon="receiver" label="Estat micro calent. [%s]"
        }
        Frame{
            Webview height=14 url="http://calespiga.ddns.net:3000/d/yImV7EWgz/calentador?orgId=1"
        }
    }

    Text label="Reg i aigua" icon="wassertank"
    {
        Frame label="Reg de l'hort SHS" {
            Selection item=RegarHortEnabledSHS icon="network" label="Control del reg [%s]" mappings=["true"="SHS", "false"="OH"]
            Setpoint item=RegarHortDuradaManualSHS label="Durada reg manual [%d min]" minValue=1 maxValue=60 step=1
            Switch item=RegarHortIniciarSHS label="Iniciar reg manual"
            Switch item=RegarHortProgramacioSHS label="Programar reg automàtic"
            Setpoint item=RegarHortDuradaProgramadaSHS label="Durada reg programat [%d min]" minValue=1 maxValue=60 step=1
            Setpoint item=RegarHortIntervalProgramatSHS label="Interval reg programat [%d h]" minValue=1 maxValue=72 step=1
            Setpoint item=RegarHortHoraIniciSHS label="Hora inici [%d h]" minValue=0 maxValue=23 step=1
            Text item=RegarHortUltimRegSHS label="Últim reg: [%s]"
        }
        Frame label="Bomba de la bassa SHS" {
            Text item=BassaRegStatusSHS label="Estat bomba: [%s]"
            Text item=BassaRegSincronitzacioSHS label="Sincronització: [%s]"
            Text item=BassaRegMicroControladorEstatSHS label="Microcontrolador: [%s]"
        }
        Frame label="Bassa" {
            Text icon="humidity" item=BassaPercentNumber label="Nivell bassa: [%d %%]"
            Text icon="water" item=BassaLitres label="Litres bassa: [%d L]"
            Text icon="flow" item=BassaAltura label="Profunditat bassa: [%d cm]"
            Text icon="faucet" item=BassaCirculacioStatus label="Estat circulacio: [%s]"
            Selection icon="switch_on_off" item=BassaModeCirculacio label="Mode circulacio: [%s]"  mappings=["hores"="Hores", "unusedPower"="Pot. sobrant"]
            Setpoint icon="time" item=BassaCirculacioHoraEncesa label="Hora inici [%.1f h]" minValue=0 maxValue=24 step=1
            Setpoint icon="time" item=BassaCirculacioHoraApagat label="Hora fi [%.1f h]" minValue=0 maxValue=24 step=1
            Setpoint icon="time" item=BassaCirculacioCadencia label="Cadència encesa: [%d %%]" minValue=10 maxValue=90 step=10
            Text icon="time" item=BassaCirculacioDescripcio label="Programació: [%s]"
            Text icon="network" item=BassaStatusConnexio label="Connexió: [%s]"
            Text icon="time" item=BassaUltimaConnexio label="Ultima connexió [%1$td/%1$tm/%1$tY %1$tT]"
        }
        Frame label="Transvassament" {
            Text item=Trasvassament_Diposit_Bassa_Estat label="Estat transvassament: [%s]" icon="water"
            Switch item=Trasvassament_Diposit_Bassa_Encesa icon="sprinkler" label="Activar transvassament"
            Setpoint item=Trasvassament_Diposit_Bassa_Durada icon="stopwatch" label="Durada transvassament [%.1f min]" minValue=1 maxValue=180 step=1
            Text icon="time" item=Trasvassament_Diposit_Bassa_Darrer label="Últim transvassament [%1$td/%1$tm/%1$tY %1$tT]"
        }
        Frame label="Aigua grisa SHS" {
            Selection item=BassaAiguaGrisaModeSHS mappings=["on"="On", "off"="Off", "horari"="Horari"]
            Setpoint item=BassaAiguaGrisaHoraIniciSHS label="Hora inici [%d h]" minValue=0 maxValue=23 step=1
            Setpoint item=BassaAiguaGrisaHoraFiSHS label="Hora fi [%d h]" minValue=0 maxValue=23 step=1
            Text item=BassaAiguaGrisaStatusSHS label="Estat bomba: [%s]"
            Text item=BassaAiguaGrisaProgramacioSHS label="Programació: [%s]"
            Text item=BassaAiguaGrisaSincronitzacioSHS label="Sincronització: [%s]"
            Text item=BassaAiguaGrisaMicroControladorEstatSHS label="Microcontrolador: [%s]"
        }
        Frame{
            Webview height=16 url="http://calespiga.ddns.net:3000/d/HSNUkZzRk/diposit?orgId=1"
        }
    }

    Text item=TemperaturesTitle label="Temperatures" icon="temperature_cold"
    {
        Frame label="Temperatures sistema elèctric" {
            Text item=ElectronicaTemperaturaSHS label="T. arm. electronica: [%.1f]" icon="temperature"
            Text item=BateriesTemperaturaSHS label="T. arm. bateries: [%.1f]" icon="temperature"
            Text item=ExteriorArmarisTemperaturaSHS label="T. fora: [%.1f]" icon="temperature"

            Setpoint item=TemperaturaObjectiuSHS icon="dial_heater" label="T. objectiu [%.1f]" minValue=5 maxValue=35 step=1
        }
        Frame label="Ventiladors" {
            Text item=VentiladorBateriesStatusSHS label="Estat vent. bat.: [%s]" icon="fan"
            Selection item=VentiladorBateriesSetSHS icon="fan" mappings=["off"="Off", "on"="On","automatic"="Automàtic"]

            Text item=VentiladorElectronicaStatusSHS label="Estat vent. elect.: [%s]" icon="fan"
            Selection item=VentiladorElectronicaSetSHS icon="fan" mappings=["off"="Off", "on"="On","automatic"="Automàtic"]

            Text item=VentiladorBateriesInconsistencySHS label="Sincronització vent. bat.: [%s]" icon="fan"
            Text item=VentiladorElectronicaInconsistencySHS label="Sincronització vent. elect.: [%s]" icon="fan"
            
            Text item=TemperaturesMicroControladorEstat icon="receiver" label="Estat micro vent. [%s]"
            
        }

        Frame{
            Webview height=16 url="http://calespiga.ddns.net:3000/d/QB--j3mRz/fotovoltaica-temperatures?orgId=1"
        }
    }
    Text item=CarChargerChargingStatusSHS label="Carregador cotxe" icon="electric_car"
    {
        Frame label="Cotxe" {
            Selection item=CarChargerSetSHS icon="switch" mappings=["off"="Off","on"="On","automatic_fv"="Automàtic FV","automatic_grid"="Automàtic xarxa"]
            Selection item=CarChargerMaxGridTariffSHS icon="energy" label="Màxima tarifa xarxa: [%s]" mappings=["vall"="Vall","pla + vall"="Pla + Vall","all tariffs"="Totes"]
            Text item=CarChargerStatusSHS icon="switch" label="Estat: [%s]"
            Text item=CarChargerSincronitzacioSHS icon="time" label="Sincronitzacio [%s]"
            Text item=CarChargerMicroControladorEstatSHS icon="network" label="Estat microcontrolador: [%s]"
            Text item=CarChargerChargingStatusSHS icon="indicator" label="Connexió: [%s]"
            Text item=CarChargerPowerSHS icon="humidity" label="Potència: [%.0f W]"
            Text item=CarChargerEnergiaAvuiSHS icon="energy" label="Energia carregada avui: [%,d Wh]"
        }
        Frame{
            Webview height=14 url="http://calespiga.ddns.net:3000/d/euckLcRRz/cotxe?orgId=1"
        }
    }
    Text item=EstufaInfrarrojosStatusSHS label="Estufes" icon="radiator"
    {
        Frame label="Estufa infrarrojos" {
            
            Selection item=EstufaInfrarrojosSetSHS icon="remote_control" mappings=["off"="Off", "600"="600W", "1200"="1200W", "automatic"="Automàtic"]
            Text item=EstufaInfrarrojosStatusSHS icon="thermostat_heater" label="Estat: [%s W]" 

            Text item=EstufaInfrarrojosUltimaConnexioSHS icon="time" label="Ultima connexió: [%s]" 
            Selection item=EstufaInfrarrojosSetTempsManualSHS icon="stopwatch" mappings=["10"="10 min", "20"="20 min", "30"="30 min", "60"="60 min"]
            
            Text item=EstufaInfrarrojosEnergiaAvuiSHS icon="energy" label="Energia avui: [%,d Wh]" 
            Text item=EstufaInfrarrojosSincronitzacioSHS icon="time" label="Sincronitzacio [%s]"
            Text item=EstufaInfrarrojosProgramatApagamentSHS icon="time" label="Apagada programada: [%s]"
            Text item=EstufaInfrarrojosMicroControladorEstatSHS icon="receiver" label="Estat micro est. [%s]"
        }
    }
    Text label="Xarxa" icon="electric_tower"
    {
        Frame label="Xarxa" {
            Text item=XarxaTarifaSHS icon="price" label="Tarifa: [%s]"
            Text item=XarxaEnergiaConsumidaAvuiSHS icon="energy" label="Energia consumida avui: [%.3f kWh]"
            Text item=XarxaEnergiaInjectadaAvuiSHS icon="energy" label="Energia injectada avui: [%.3f kWh]"
            Text item=XarxaEnergiaConsumidaVallAvuiSHS icon="energy" label="Consum vall avui: [%.3f kWh]"
            Text item=XarxaEnergiaConsumidaPlaAvuiSHS icon="energy" label="Consum pla avui: [%.3f kWh]"
            Text item=XarxaEnergiaConsumidaPicAvuiSHS icon="energy" label="Consum pic avui: [%.3f kWh]"
            Text item=XarxaEnergiaInjectadaVallAvuiSHS icon="energy" label="Injecció vall avui: [%.3f kWh]"
            Text item=XarxaEnergiaInjectadaPlaAvuiSHS icon="energy" label="Injecció pla avui: [%.3f kWh]"
            Text item=XarxaEnergiaInjectadaPicAvuiSHS icon="energy" label="Injecció pic avui: [%.3f kWh]"
        }
    }
    Text item=AlarmsTitle label="Alertes" icon="alert"
    {
        Frame label="Comunicació bassa" {
            Text item=AlarmBassaComunicacio label="Estat [%s]" icon="alert"
            Text icon="time" item=AlarmBassaComunicacioTimeOn label="Ultim cop ON: [%1$td/%1$tm/%1$tY %1$tT]"
            Text icon="time" item=AlarmBassaComunicacioTimeOff label="Ultim cop OFF: [%1$td/%1$tm/%1$tY %1$tT]"
            Switch item=AlarmBassaComunicacioNotification icon="notification" label="Notifica" mappings=["ON"="Si", "OFF"="No"]
            Setpoint item=AlarmBassaComunicacioTimeNotifications icon="stopwatch" label="Temps entre notif. [%.1f m]" minValue=1 maxValue=30 step=1
            Setpoint item=AlarmBassaComunicacio_Seconds icon="stopwatch" label="Temps limit [%.1f s]" minValue=30 maxValue=120 step=10
        }
        Frame label="Comunicació diposit" {
            Text item=AlarmDipositComunicacio label="Estat [%s]" icon="alert"
            Text icon="time" item=AlarmDipositComunicacioTimeOn label="Ultim cop ON: [%1$td/%1$tm/%1$tY %1$tT]"
            Text icon="time" item=AlarmDipositComunicacioTimeOff label="Ultim cop OFF: [%1$td/%1$tm/%1$tY %1$tT]"
            Switch item=AlarmDipositComunicacioNotification icon="notification" label="Notifica" mappings=["ON"="Si", "OFF"="No"]
            Setpoint item=AlarmDipositComunicacioTimeNotifications icon="stopwatch" label="Temps entre notif. [%.1f m]" minValue=1 maxValue=30 step=1
            Setpoint item=AlarmDipositComunicacio_Seconds icon="stopwatch" label="Temps limit [%.1f s]" minValue=30 maxValue=120 step=10
        }
        Frame label="Circulacio bloquejada" {
            Text item=AlarmBassaCirculacio label="Estat [%s]" icon="alert"
            Text icon="time" item=AlarmBassaCirculacioTimeOn label="Ultim cop ON: [%1$td/%1$tm/%1$tY %1$tT]"
            Text icon="time" item=AlarmBassaCirculacioTimeOff label="Ultim cop OFF: [%1$td/%1$tm/%1$tY %1$tT]"
            Switch item=AlarmBassaCirculacioNotification icon="notification" label="Notifica" mappings=["ON"="Si", "OFF"="No"]
            Setpoint item=AlarmBassaCirculacioTimeNotifications icon="stopwatch" label="Temps entre notif. [%.1f m]" minValue=1 maxValue=30 step=1
            Setpoint item=AlarmBassaCirculacio_Seconds icon="stopwatch" label="Temps limit [%.1f m]" minValue=20 maxValue=120 step=10
        }
        Frame label="Transvassament no executat" {
            Text item=AlarmTransvassament label="Estat [%s]" icon="alert"
            Text icon="time" item=AlarmTransvassamentTimeOn label="Ultim cop ON: [%1$td/%1$tm/%1$tY %1$tT]"
            Text icon="time" item=AlarmTransvassamentTimeOff label="Ultim cop OFF: [%1$td/%1$tm/%1$tY %1$tT]"
            Switch item=AlarmTransvassamentNotification icon="notification" label="Notifica" mappings=["ON"="Si", "OFF"="No"]
            Setpoint item=AlarmTransvassamentTimeNotifications icon="stopwatch" label="Temps entre notif. [%.1f m]" minValue=1 maxValue=30 step=1
            Setpoint item=AlarmTransvassament_Seconds icon="stopwatch" label="Temps limit [%.1f m]" minValue=20 maxValue=120 step=10
        }
        Frame label="Problema de connexio a xarxa" {
            Text item=AlarmGridConnection label="Estat [%s]" icon="alert"
            Text icon="time" item=AlarmGridConnectionTimeOn label="Ultim cop ON: [%1$td/%1$tm/%1$tY %1$tT]"
            Text icon="time" item=AlarmGridConnectionTimeOff label="Ultim cop OFF: [%1$td/%1$tm/%1$tY %1$tT]"
            Switch item=AlarmGridConnectionNotification icon="notification" label="Notifica" mappings=["ON"="Si", "OFF"="No"]
            Setpoint item=AlarmGridConnectionTimeNotifications icon="stopwatch" label="Temps entre notif. [%.1f m]" minValue=1 maxValue=30 step=1
            Setpoint item=AlarmGridConnection_Seconds icon="stopwatch" label="Temps limit [%.1f m]" minValue=5 maxValue=60 step=5
        }
    }
}
