String Cotxe_Sensor_Lectura "[%s]" {channel="exec:command:cotxe:output"}
Number:Power Cotxe_Potencia_Sensor "Sensor consum (W)"  //what the cotxe is using ATM direcly from sensor
Number:Power Cotxe_Energia_Sensor "Sensor energia (Wh)"  //what the cotxe has used forever

Switch CotxeEncesa_Control "Encesa del cotxe" (GPIOOutput, GPIOOutputInverted) //this is the actual item tant turns on or off the charger
String CotxeEncesa_ControlNumber "3" // Item required with the GPIO number
Switch CotxeEncesa_Control_Proxy "Encesa del cotxe" <connect>   //proxy to turn on or off the cotxe, or test it

// ITEMS FOR THE TRANSITION TO SHS and ARDUINO/ESP32
String CotxeEncesa_Control_MQTTProxy "Encesa cotxe MQTT" {channel="mqtt:topic:cotxe:CotxeSet"} //proxy to turn on or off the cotxe, or test it
String CotxePotenciaMQTT "Potencia cotxe MQTT" {channel="mqtt:topic:cotxe:CotxePower"} //proxy to send the power of the cotxe, or test it
String CotxeEnergiaMQTT "Energia cotxe MQTT" {channel="mqtt:topic:cotxe:CotxeEnergy"} //proxyto send the energia of the cotxe, or test it
String CotxeStatusMQTT "Estat cotxe MQTT" {channel="mqtt:topic:cotxe:CotxeStatus"} //proxy to send the status of the cotxe, or test it
// END ITEMS FOR THE TRANSITION TO SHS and ARDUINO/ESP32
